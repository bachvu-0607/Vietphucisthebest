# Set real secret values in your host's environment-variable settings.
GEMINI_API_KEY=""

# Optional: required only when using OpenAI image generation.
OPENAI_API_KEY=""

# Public HTTPS URL of the deployed app, without a trailing slash.
APP_URL=""

# Required in production: random secret, at least 32 characters.
JWT_SECRET=""
# Set NODE_ENV=production in the hosting service; leave unset for local development.
# Persistent local filesystem; production paths are examples only.
# DATA_DIR="/srv/vietphuc/data"
# BACKUPS_DIR="/srv/vietphuc-backups"
AI_ENABLED="true"
AI_DAILY_LIMIT="5"
AI_ACCOUNT_TOTAL_LIMIT="20"
AI_GLOBAL_DAILY_LIMIT="100"
